
<%-include('../cabecalho.ejs')%>

<h1>Editar Reserva</h1>

<div>
    <a href="/reserva/lst" class="btn">Listar</a>
</div>

<div>
    <form method="post">

        <label>Cliente:</label>

        <select name="cliente" required>

            <option value="">Selecione o cliente</option>

            <% for (const cliente of Clientes) { %>

                <option
                    value="<%=cliente._id%>"
                    <%= Reserva.cliente &&
                        Reserva.cliente.toString() === cliente._id.toString()
                        ? 'selected'
                        : '' %>>

                    <%=cliente.nome%> - <%=cliente.telefone%>

                </option>

            <% } %>

        </select>

        <br><br>

        <label>Mesa:</label>

        <select name="mesa" required>

            <option value="">Selecione a mesa</option>

            <% for (const mesa of Mesas) { %>

                <option
                    value="<%=mesa._id%>"
                    <%= Reserva.mesa &&
                        Reserva.mesa.toString() === mesa._id.toString()
                        ? 'selected'
                        : '' %>>

                    Mesa - Capacidade: <%=mesa.capacidade%> -
                    Status: <%=mesa.status%>

                </option>

            <% } %>

        </select>

        <br><br>

        <label>Data e hora:</label>

        <input
            type="datetime-local"
            name="dataHora"
            value="<%=new Date(Reserva.dataHora).toISOString().slice(0,16)%>"
            required>

        <br><br>

        <button type="submit" class="btn edit">
            Salvar
        </button>

    </form>
</div>

<%-include('../rodape.ejs')%>