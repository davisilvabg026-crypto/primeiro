<%-include('../cabecalho.ejs')%>

<h1>Editar Prato</h1>

<div>
    <a href="/prato/lst" class="btn">Listar</a>
</div>

<div>
    <form method="post">

        <label>Nome do prato:</label>
        <input type="text" name="nome"
        value="<%=Prato.nome%>" required><br>

        <label>Categoria:</label>
        <select name="categoria" required>

            <option value="entrada"
                <%= Prato.categoria === 'entrada' ? 'selected' : '' %>>
                Entrada
            </option>

            <option value="prato principal"
                <%= Prato.categoria === 'prato principal' ? 'selected' : '' %>>
                Prato principal
            </option>

            <option value="sobremesa"
                <%= Prato.categoria === 'sobremesa' ? 'selected' : '' %>>
                Sobremesa
            </option>

            <option value="bebida"
                <%= Prato.categoria === 'bebida' ? 'selected' : '' %>>
                Bebida
            </option>

        </select><br>

        <label>Disponível:</label>
        <select name="disponivel" required>

            <option value="true"
                <%= Prato.disponivel ? 'selected' : '' %>>
                Sim
            </option>

            <option value="false"
                <%= !Prato.disponivel ? 'selected' : '' %>>
                Não
            </option>

        </select><br>

        <button type="submit" class="btn edit">Salvar</button>

    </form>
</div>

<%-include('../rodape.ejs')%>