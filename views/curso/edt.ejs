<%-include('../cabecalho.ejs')%>

    <h1>Editar Cliente</h1>

    <div>

        <a href="/curso/lst" class="btn">Listar</a>

    </div>

    <div>

        <form method="post" enctype="multipart/form-data">

            <label>Nome:</label>

            <input type="text" name="nome" value="<%=Cliente.nome%>" required>

            <br>

            <label>Telefone:</label>

            <input type="text" name="telefone" value="<%=Cliente.telefone%>" required>

            <br>

            <label>E-mail:</label>

            <input type="text" name="email" value="<%=Cliente.email || ''%>">

            <br>

            <label>Arquivo atual:</label>

            <% if (Cliente.imagem) { %>

                <br>

                <img src="<%=Cliente.imagem%>" width="150" alt="Imagem atual">

                <br>

                <p>
                    <%=Cliente.imagem.split(' /').pop()%>
                </p>

                <% } else { %>

                    <p>Nenhuma imagem cadastrada.</p>

                    <% } %>

                        <br>

                        <label>Escolher novo arquivo:</label>

                        <input type="file" name="imagem" accept="image/*">

                        <br><br>

                        <button type="submit" class="btn edit">
                            Salvar
                        </button>

        </form>

    </div>

    <%-include('../rodape.ejs')%>