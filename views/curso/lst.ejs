<%-include('../cabecalho.ejs')%>

<h1>Clientes</h1>

<div class="search">

    <form action="/curso/lst" method="post">

        <input
            type="text"
            name="filtro"
            placeholder="digite nome ou telefone">

        <button type="submit" class="btn">

            Pesquisar

        </button>

    </form>

</div>

<a href="/curso/add" class="btn add">+ Cliente</a>

<table>

    <tr>

        <th>Imagem</th>

        <th>Nome</th>

        <th>Telefone</th>

        <th>E-mail</th>

        <th>Ações</th>

    </tr>

<% for (const cliente of Cursos) { %>

    <tr>

        <td>

            <% if (cliente.imagem) { %>

                <img
                    src="<%=cliente.imagemBase64()%>"
                    width="100"
                    alt="Imagem de <%=cliente.nome%>">

            <% } else { %>

                Sem imagem

            <% } %>

        </td>

        <td><%=cliente.nome%></td>

        <td><%=cliente.telefone%></td>

        <td><%=cliente.email || ''%></td>

        <td>

            <a
                href="/curso/edt/<%=cliente.id%>"
                class="btn edit">

                Editar

            </a>

            <a
                href="/curso/del/<%=cliente.id%>"
                class="btn delete">

                Excluir

            </a>

        </td>

    </tr>

<% } %>

</table>

<%-include('../rodape.ejs')%>