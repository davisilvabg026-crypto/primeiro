<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minhas Reservas - Restaurante Vila Nova</title>
    <link rel="stylesheet" href="/css/style-site.css">
</head>

<body>

    <header>
        <div class="header-container">
            <a href="/site" class="brand">
                <div>
                    <span class="brand-title">Vila Nova</span>
                    <span class="brand-subtitle">Restaurante & Gastronomia</span>
                </div>
            </a>
            <nav>
                <ul>
                    <li><a href="/site">Início</a></li>
                    <li><a href="/site/cardapio">Cardápio</a></li>
                    <li><a href="/site/reserva">Fazer Reserva</a></li>
                    <li><a href="/site/minhas-reservas" class="active">Minhas Reservas</a></li>
                    <li><a href="/admin" class="btn-mode">Área Admin</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <h2 class="section-title">Consultar Minha Reserva</h2>
        <p class="section-subtitle">Visualize o status da sua reserva cadastrada.</p>

        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Mesa</th>
                        <th>Capacidade</th>
                        <th>Data e Horário</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (reservas && reservas.length> 0) { %>
                        <% reservas.forEach((reserva, index)=> { %>
                            <tr>
                                <td>
                                    <%= reserva.cliente ? reserva.cliente.nome : 'Cliente não encontrado' %>
                                </td>
                                <td>
                                    <%= reserva.mesa && reserva.mesa.nome ? reserva.mesa.nome : 'Mesa ' + (index + 1) %>
                                </td>
                                <td>
                                    <%= reserva.mesa ? reserva.mesa.capacidade + ' Pessoas' : '-' %>
                                </td>
                                <td>
                                    <%= new Date(reserva.dataHora).toLocaleString('pt-BR', { dateStyle: 'short' ,
                                        timeStyle: 'short' }) %>
                                </td>
                                <td>
                                    <% if (reserva.mesa && reserva.mesa.status==='ocupada' ) { %>
                                        <span class="badge badge-danger">Ocupada</span>
                                        <% } else { %>
                                            <span class="badge badge-warning">Reservada</span>
                                            <% } %>
                                </td>
                            </tr>
                            <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" style="text-align: center; padding: 1.5rem;">
                                            Nenhuma reserva cadastrada no momento.
                                        </td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <footer>
        <p>&copy; 2026 Restaurante Vila Nova. Todos os direitos reservados.</p>
    </footer>

</body>

</html>