<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minhas Reservas - Restaurante Vila Nova</title>
    <link rel="stylesheet" href="/css/style-site.css">
</head>

<body>

    <header>
        <div class="header-container">
            <a href="/site" class="brand">
                <div>
                    <span class="brand-title">Vila Nova</span>
                    <span class="brand-subtitle">Restaurante & Gastronomia</span>
                </div>
            </a>
            <nav>
                <ul>
                    <li><a href="/site">Início</a></li>
                    <li><a href="/site/cardapio">Cardápio</a></li>
                    <li><a href="/site/reserva">Fazer Reserva</a></li>
                    <li><a href="/site/minhas-reservas" class="active">Minhas Reservas</a></li>
                    <li><a href="/admin" class="btn-mode">Área Admin</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <h2 class="section-title">Consultar Minha Reserva</h2>
        <p class="section-subtitle">Visualize o status da sua reserva cadastrada.</p>

        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Mesa</th>
                        <th>Capacidade</th>
                        <th>Data e Horário</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Carlos Eduardo</td>
                        <td>Mesa VIP 01</td>
                        <td>2 Pessoas</td>
                        <td>03/11/2026 - 20:00</td>
                        <td><span class="badge badge-warning">Reservada</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </main>

    <footer>
        <p>&copy; 2026 Restaurante Vila Nova. Todos os direitos reservados.</p>
    </footer>

</body>

</html>