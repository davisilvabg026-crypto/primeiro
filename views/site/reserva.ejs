<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reserva - Restaurante Vila Nova</title>
    <link rel="stylesheet" href="/css/style-site.css">
</head>

<body>

    <header>
        <div class="header-container">
            <a href="/site" class="brand">
                <div>
                    <span class="brand-title">Vila Nova</span>
                    <span class="brand-subtitle">Restaurante & Gastronomia</span>
                </div>
            </a>
            <nav>
                <ul>
                    <li><a href="/site">Início</a></li>
                    <li><a href="/site/cardapio">Cardápio</a></li>
                    <li><a href="/site/reserva" class="active">Fazer Reserva</a></li>
                    <li><a href="/site/minhas-reservas">Minhas Reservas</a></li>
                    <li><a href="/admin" class="btn-mode">Área Admin</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <h2 class="section-title" style="text-align: center;">Reserve sua Mesa</h2>
        <p class="section-subtitle" style="text-align: center;">
            Preencha o formulário para garantir seu lugar em nosso restaurante.
        </p>

        <div class="form-container">
            <form action="/site/minhas-reservas" method="GET">
                <div class="form-group">
                    <label for="nome">Nome Completo</label>
                    <input type="text" id="nome" name="nome" placeholder="Seu nome" required>
                </div>

                <div class="form-group">
                    <label for="telefone">Telefone / WhatsApp</label>
                    <input type="tel" id="telefone" name="telefone" placeholder="(00) 00000-0000" required>
                </div>

                <div class="form-group">
                    <label for="email">E-mail (Opcional)</label>
                    <input type="email" id="email" name="email" placeholder="seu@email.com">
                </div>

                <div class="form-group">
                    <label for="pessoas">Quantidade de Pessoas</label>
                    <select id="pessoas" name="pessoas" required>
                        <option value="2">2 Pessoas (Mesa VIP 01)</option>
                        <option value="4">4 Pessoas (Mesa Família 02)</option>
                        <option value="6">6 Pessoas (Mesa Janela 03)</option>
                        <option value="8">8 Pessoas (Mesa Salão 04)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="dataHora">Data e Horário</label>
                    <input type="datetime-local" id="dataHora" name="dataHora" required>
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%;">
                    Confirmar Reserva
                </button>
            </form>
        </div>
    </main>

    <footer>
        <p>&copy; 2026 Restaurante Vila Nova. Todos os direitos reservados.</p>
    </footer>

</body>

</html>