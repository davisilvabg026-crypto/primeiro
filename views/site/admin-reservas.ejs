<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerenciar Reservas - Admin</title>
    <link rel="stylesheet" href="/css/style-site.css">
</head>

<body>

    <header>
        <div class="header-container">
            <a href="/admin" class="brand">
                <div>
                    <span class="brand-title">Vila Nova</span>
                    <span class="brand-subtitle">Painel de Gestão</span>
                </div>
            </a>
            <nav>
                <ul>
                    <li><a href="/site" class="btn-mode">Ver Site do Cliente</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <h2 class="section-title">Gerenciamento de Reservas</h2>
        <p class="section-subtitle">Consulte e organize todas as reservas ativas.</p>

        <div style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
            <a href="/admin" class="btn btn-accent btn-small">Dashboard</a>
            <a href="/admin/mesas" class="btn btn-accent btn-small">Mesas</a>
            <a href="/admin/clientes" class="btn btn-accent btn-small">Clientes</a>
            <a href="/admin/pratos" class="btn btn-accent btn-small">Pratos</a>
            <a href="/admin/reservas" class="btn btn-primary btn-small">Reservas</a>
        </div>

        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Mesa</th>
                        <th>Data e Horário</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (reservas && reservas.length> 0) { %>
                        <% reservas.forEach((reserva, index)=> { %>
                            <tr>
                                <td>
                                    <%= reserva.cliente ? reserva.cliente.nome : 'Cliente não encontrado' %>
                                </td>
                                <td>
                                    <%= reserva.mesa && reserva.mesa.nome ? reserva.mesa.nome : 'Mesa ' + (index + 1) %>
                                        <% if (reserva.mesa && reserva.mesa.capacidade) { %>
                                            (<%= reserva.mesa.capacidade %> lugares)
                                                <% } %>
                                </td>
                                <td>
                                    <%= new Date(reserva.dataHora).toLocaleString('pt-BR', { dateStyle: 'short' ,
                                        timeStyle: 'short' }) %>
                                </td>
                                <td style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                    <a href="/reserva/edt/<%= reserva._id %>"
                                        class="btn btn-primary btn-small">Editar</a>
                                    <a href="/reserva/del/<%= reserva._id %>" class="btn btn-danger btn-small"
                                        onclick="return confirm('Tem certeza que deseja cancelar esta reserva?')">Cancelar</a>
                                </td>
                            </tr>
                            <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" style="text-align: center; padding: 1.5rem;">
                                            Nenhuma reserva cadastrada no momento.
                                        </td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <footer>
        <p>&copy; 2026 Restaurante Vila Nova - Módulo Administrativo.</p>
    </footer>

</body>

</html>